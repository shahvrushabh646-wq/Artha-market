# Artha background notification configuration
# Never commit real secrets. Add these as deployment environment variables.

# Push provider (optional until credentials are configured)
PUSH_PROVIDER=
PUSH_API_URL=
PUSH_API_KEY=
PUSH_APP_ID=

# Scheduler/cron protection (optional)
CRON_SECRET=

# Notification timezone and schedule (IST)
NOTIFICATION_TIMEZONE=Asia/Kolkata
NOTIFICATION_TIMES=11:00,15:00

# Rule notification settings
RULE_ALERT_DAYS=3
RULE_90_PRICE=20
