# Artha background notification configuration
# NEVER put real API keys in GitHub/source code.

# OneSignal Web Push (free tier)
VITE_ONESIGNAL_APP_ID=
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
PUSH_PROVIDER=onesignal
PUSH_API_URL=https://api.onesignal.com/notifications?c=push

# Scheduler protection
CRON_SECRET=
ARTHA_NOTIFICATION_URL=

# Notification schedule (IST)
NOTIFICATION_TIMEZONE=Asia/Kolkata
NOTIFICATION_TIMES=11:00,15:00

# Rule notification settings
RULE_ALERT_DAYS=3
RULE_90_PRICE=20
